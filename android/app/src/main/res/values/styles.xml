<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 7–14 need explicit transparent system bars. -->
    <style name="LegacySystemBars" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="PlayerWindowTheme" parent="LegacySystemBars">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="LaunchTheme" parent="PlayerWindowTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="PlayerWindowTheme">
        <item name="android:windowBackground">#546B7F</item>
    </style>
</resources>
