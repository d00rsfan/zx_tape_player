#!/usr/bin/env bash
# `locate` shim for fastforge's AppImage maker.
#
# The maker resolves each `include:` entry by shelling out to `locate <entry>`
# and copying the first line of stdout. Our make_config.yaml lists absolute
# paths (generated by generate_make_config.sh), so resolution is just an
# existence check + echo — no need for plocate or an updatedb index, and no
# risk of a stale index missing a freshly-rebuilt library.
#
# The trailing sleep works around a race in fastforge's shell_executor
# (it constructs the ProcessResult right after `await process.exitCode`,
# without draining stdout): under the concurrent per-library `locate`
# fan-out, the captured stdout is occasionally still null when the result is
# built, and the maker then does `value.stdout as String` -> TypeError ->
# "type 'Null' is not a subtype of type 'String'". Staying alive briefly
# after writing guarantees the echoed path reaches the Dart side before this
# process exits, so stdout is non-null by the time exitCode resolves.
#
# Put this directory first on PATH before running `fastforge release`.
for q in "$@"; do
    [ -e "$q" ] && printf '%s\n' "$q"
done
sleep 0.05
exit 0
